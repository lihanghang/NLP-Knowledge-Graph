---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script is:inline>
	// GitHub Pages 区分路径大小写，而 Astro 会把英文路由标准化为小写。
	// 仅在 404 页面修正旧书签中的大写片段（例如 /RAG/ → /rag/）。
	if (document.title.startsWith('404 |')) {
		const base = '/NLP-Knowledge-Graph/';
		if (location.pathname.startsWith(base)) {
			try {
				const decoded = decodeURIComponent(location.pathname.slice(base.length));
				const normalized = decoded.replace(/[A-Z]/g, (letter) => letter.toLowerCase());
				if (normalized !== decoded) {
					const encoded = normalized.split('/').map(encodeURIComponent).join('/');
					location.replace(`${base}${encoded}${location.search}${location.hash}`);
				}
			} catch {
				// 路径无法解码时保留默认 404 页面。
			}
		}
	}
</script>

<script>
	// PDF 全屏：给每个阅读器加按钮。浏览器不支持元素全屏时（如 iPhone Safari）
	// 退化为 CSS 铺满视口的"伪全屏"
	function setup() {
		document.querySelectorAll<HTMLElement>('.pdf-viewer-container').forEach((box) => {
			if (box.querySelector('.pdf-fullscreen-btn')) return;
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'pdf-fullscreen-btn';
			box.prepend(btn);

			const isNative = () => document.fullscreenElement === box;
			const isActive = () => isNative() || box.classList.contains('is-pseudo-fullscreen');
			const render = () => {
				const active = isActive();
				btn.textContent = active ? '✕ 退出全屏' : '⛶ 全屏';
				btn.setAttribute('aria-label', active ? '退出全屏' : '全屏查看PDF');
				document.documentElement.classList.toggle('pdf-fullscreen-lock', box.classList.contains('is-pseudo-fullscreen'));
			};

			btn.addEventListener('click', async () => {
				if (isNative()) return document.exitFullscreen();
				if (box.classList.contains('is-pseudo-fullscreen')) {
					box.classList.remove('is-pseudo-fullscreen');
					return render();
				}
				try {
					if (!box.requestFullscreen) throw new Error('unsupported');
					await box.requestFullscreen();
				} catch {
					box.classList.add('is-pseudo-fullscreen');
					render();
				}
			});

			document.addEventListener('fullscreenchange', render);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && box.classList.contains('is-pseudo-fullscreen')) {
					box.classList.remove('is-pseudo-fullscreen');
					render();
				}
			});
			render();
		});
	}

	setup();
	document.addEventListener('astro:page-load', setup);
</script>

<script>
	async function setupMobilePdfViewers() {
		const viewers = [...document.querySelectorAll<HTMLElement>('.mobile-pdf-viewer:not([data-pdf-ready])')];
		if (!viewers.length) return;

		const [pdfjs, workerModule] = await Promise.all([
			import('pdfjs-dist'),
			import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
		]);
		pdfjs.GlobalWorkerOptions.workerSrc = workerModule.default;

		for (const viewer of viewers) {
			viewer.dataset.pdfReady = 'loading';
			const url = viewer.dataset.pdfUrl;
			const fallback = viewer.dataset.pdfFallback;
			const stage = viewer.querySelector<HTMLElement>('.mobile-pdf-stage');
			const canvas = viewer.querySelector<HTMLCanvasElement>('.mobile-pdf-canvas');
			const status = viewer.querySelector<HTMLElement>('.mobile-pdf-status');
			const current = viewer.querySelector<HTMLElement>('[data-pdf-page]');
			const count = viewer.querySelector<HTMLElement>('[data-pdf-count]');
			const previous = viewer.querySelector<HTMLButtonElement>('[data-pdf-prev]');
			const next = viewer.querySelector<HTMLButtonElement>('[data-pdf-next]');
			if (!url || !stage || !canvas || !status || !current || !count || !previous || !next) continue;

			try {
				const pdf = await pdfjs.getDocument({ url }).promise;
				let pageNumber = 1;
				let rendering = false;
				let renderAgain = false;

				count.textContent = String(pdf.numPages);

				const renderPage = async () => {
					if (rendering) {
						renderAgain = true;
						return;
					}
					rendering = true;
					status.hidden = false;
					status.textContent = `正在加载第 ${pageNumber} 页…`;
					try {
						const page = await pdf.getPage(pageNumber);
						const baseViewport = page.getViewport({ scale: 1 });
						const availableWidth = Math.min(Math.max(stage.clientWidth - 24, 280), 960);
						const viewport = page.getViewport({ scale: availableWidth / baseViewport.width });
						const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
						const context = canvas.getContext('2d');
						if (!context) throw new Error('Canvas unavailable');

						canvas.width = Math.floor(viewport.width * pixelRatio);
						canvas.height = Math.floor(viewport.height * pixelRatio);
						canvas.style.width = `${Math.floor(viewport.width)}px`;
						canvas.style.height = `${Math.floor(viewport.height)}px`;
						canvas.hidden = false;
						await page.render({
							canvasContext: context,
							viewport,
							transform: pixelRatio === 1 ? undefined : [pixelRatio, 0, 0, pixelRatio, 0, 0],
						}).promise;

						current.textContent = String(pageNumber);
						previous.disabled = pageNumber <= 1;
						next.disabled = pageNumber >= pdf.numPages;
						status.hidden = true;
						stage.scrollTo({ top: 0 });
					} finally {
						rendering = false;
						if (renderAgain) {
							renderAgain = false;
							void renderPage();
						}
					}
				};

				previous.addEventListener('click', () => {
					if (pageNumber <= 1) return;
					pageNumber -= 1;
					void renderPage();
				});
				next.addEventListener('click', () => {
					if (pageNumber >= pdf.numPages) return;
					pageNumber += 1;
					void renderPage();
				});

				viewer.dataset.pdfReady = 'true';
				await renderPage();
			} catch (error) {
				console.error('PDF mobile viewer failed:', error);
				viewer.dataset.pdfReady = 'error';
				status.textContent = 'PDF 暂时无法载入。';
				const link = document.createElement('a');
				link.href = fallback || url;
				link.target = '_blank';
				link.rel = 'noopener';
				link.textContent = '在浏览器中打开';
				status.append(' ', link);
			}
		}
	}

	void setupMobilePdfViewers();
	document.addEventListener('astro:page-load', () => void setupMobilePdfViewers());
</script>
